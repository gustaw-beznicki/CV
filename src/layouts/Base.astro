---
import "@fontsource-variable/instrument-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/global.css";

import Certifications from "../components/Certifications.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Education from "../components/Education.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";
import Interests from "../components/Interests.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Languages from "../components/Languages.astro";
import Logo from "../components/Logo.astro";
import Sidebar from "../components/Sidebar.astro";
import Skills from "../components/Skills.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import type { CVContent } from "../content/types";

interface Props {
  content: CVContent;
}
const { content } = Astro.props;

const site =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://gustawbeznicki.dev";
const enHref = `${site}/`;
const plHref = `${site}/pl`;
const canonical = content.locale === "pl" ? plHref : enHref;
const ogImage = `${site}/og-image.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gustaw Beźnicki",
  jobTitle: "Senior Software Engineer",
  url: enHref,
  email: `mailto:${content.contact.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Gdańsk",
    addressCountry: "PL",
  },
  sameAs: [content.footer.githubUrl, content.footer.linkedinUrl],
};
---

<!doctype html>
<html lang={content.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ecebe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111413" media="(prefers-color-scheme: dark)" />
    <!-- Theme before first paint (no flash): saved choice, else the OS setting. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="pl" href={plHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={content.locale === "pl" ? "pl_PL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <canvas class="circuit-bg" aria-hidden="true"></canvas>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="brand-mark" href="#top" aria-label={content.ui.backToTop}>
      <Logo variant="mark" />
    </a>
    <div class="top-controls">
      <ThemeToggle content={content} />
      <LanguageSwitcher locale={content.locale} />
    </div>
    <Hero content={content} />
    <main>
      <Sidebar content={content} />
      <article class="content">
        <Highlights content={content} />
        <Skills content={content} />
        <Experience content={content} />
        <Education content={content} />
        <Certifications content={content} />
        <Languages content={content} />
        <Interests content={content} />
      </article>
    </main>
    <Footer content={content} />

    <script>
      import "../scripts/enhance";
    </script>
    <CookieBanner content={content} />
  </body>
</html>
