---
// The hero's logo chip: a CPU package — PCB substrate with gold pins, traces
// and SMD parts, and a raised silver die with the deer engraved into it.
// Decorative only (aria-hidden); tilt / light vars come from enhance.ts.
import Logo from "./Logo.astro";

// One side of the package (left edge, viewBox 0 0 100 100); the other three
// sides are the same group rotated around the centre.
const PINS = 14;
const pins = Array.from({ length: PINS }, (_, k) => {
  const y = 17.5 + k * 5;
  const ty = 50 + (y - 50) * 0.78; // traces fan in towards the die
  return { y, trace: `M1 ${y}H4.2L9.6 ${ty.toFixed(2)}` };
});
const sides = [0, 90, 180, 270];
---

<div class="hero-chip" aria-hidden="true">
  <div class="chip">
    <svg class="chip-board" viewBox="0 0 100 100" focusable="false">
      <defs>
        <linearGradient id="chip-pin" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#8a6a3f" />
          <stop offset="0.45" stop-color="#f3d6a6" />
          <stop offset="1" stop-color="#9a7646" />
        </linearGradient>
        <g id="chip-side">
          {pins.map((p) => (
            <Fragment>
              <rect class="chip-pin" x="-6.5" y={p.y - 1.3} width="8" height="2.6" rx="0.5" />
              <path class="chip-trace" d={p.trace} />
              <circle class="chip-via" cx="4.2" cy={p.y} r="0.55" />
            </Fragment>
          ))}
          <g class="chip-smd" transform="translate(2.4 3.6)">
            <rect class="smd-body" width="2.4" height="4.4" rx="0.3" />
            <rect class="smd-cap" width="2.4" height="1" rx="0.3" />
            <rect class="smd-cap" y="3.4" width="2.4" height="1" rx="0.3" />
          </g>
          <circle class="chip-fiducial" cx="7.4" cy="4.2" r="1" />
        </g>
      </defs>
      {sides.map((deg) => <use href="#chip-side" transform={`rotate(${deg} 50 50)`} />)}
    </svg>
    <div class="chip-die">
      <Logo variant="chip" />
      <svg class="die-mark" viewBox="0 0 40 6" focusable="false">
        <text x="0" y="5">GB-01 · 2026</text>
      </svg>
      <span class="chip-sheen"></span>
    </div>
  </div>
</div>
