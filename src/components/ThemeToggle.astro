---
import type { CVContent } from "../content/types";

interface Props {
  content: CVContent;
}
const { ui } = Astro.props.content;
---

<!-- Hidden until enhance.ts wires it up (it needs JS to do anything). -->
<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-dark={ui.themeToDark}
  data-label-light={ui.themeToLight}
  aria-label={ui.themeToDark}
  title={ui.themeToDark}
  hidden
>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
  </svg>
</button>
