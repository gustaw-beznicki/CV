{
  "name": "cv",
  "compatibility_date": "2026-06-04",
  "main": "worker/index.js",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // Upstream for the first-party Umami analytics proxy (/_a/* -> UMAMI_HOST).
  // Empty here so local/CI builds no-op; set the real Cloudflare Tunnel URL in
  // production with: wrangler secret put UMAMI_HOST  (or the dashboard).
  // See docs/umami-deployment.md.
  "vars": {
    "UMAMI_HOST": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "gustawbeznicki.dev", "custom_domain": true },
    { "pattern": "www.gustawbeznicki.dev", "custom_domain": true }
  ]
}
